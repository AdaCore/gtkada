<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="constraints">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <property name="margin-top">12</property>
    <property name="margin-bottom">12</property>
    <child>
      <object class="GtkLabel">
        <property name="label">This layout, including its invisible spacer guide, is loaded from constraints.ui.</property>
        <property name="wrap">true</property>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="stage">
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <property name="width-request">360</property>
        <property name="height-request">240</property>
        <property name="layout-manager">
          <object class="GtkConstraintLayout" id="layout">
            <constraints>
              <guide name="gap" min-width="24" nat-width="24" max-width="24" min-height="0" nat-height="0" max-height="0" strength="strong" />
              <constraint target="a" target-attribute="start" relation="eq" source="super" source-attribute="start" strength="required" constant="16" />
              <constraint target="a" target-attribute="end" relation="eq" source="gap" source-attribute="start" strength="required" />
              <constraint target="b" target-attribute="start" relation="eq" source="gap" source-attribute="end" strength="required" />
              <constraint target="b" target-attribute="end" relation="eq" source="super" source-attribute="end" strength="required" constant="-16" />
              <constraint target="a" target-attribute="width" relation="eq" source="b" source-attribute="width" strength="required" />
              <constraint target="a" target-attribute="top" relation="eq" source="super" source-attribute="top" strength="required" constant="16" />
              <constraint target="b" target-attribute="top" relation="eq" source="a" source-attribute="top" strength="required" />
              <constraint target="b" target-attribute="bottom" relation="eq" source="a" source-attribute="bottom" strength="required" />
              <constraint target="c" target-attribute="start" relation="eq" source="a" source-attribute="start" strength="required" />
              <constraint target="c" target-attribute="end" relation="eq" source="b" source-attribute="end" strength="required" />
              <constraint target="c" target-attribute="top" relation="eq" source="a" source-attribute="bottom" strength="required" constant="16" />
              <constraint target="c" target-attribute="bottom" relation="eq" source="super" source-attribute="bottom" strength="required" constant="-16" />
              <constraint target="c" target-attribute="height" relation="eq" source="a" source-attribute="height" strength="required" />
            </constraints>
          </object>
        </property>
        <child>
          <object class="GtkButton" id="a">
            <property name="label">Child 1</property>
            <style>
              <class name="suggested-action" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="b">
            <property name="label">Child 2</property>
            <style>
              <class name="suggested-action" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="c">
            <property name="label">Child 3</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
