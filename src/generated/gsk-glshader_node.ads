--  A render node using a GL shader when drawing its children nodes.

pragma Warnings (Off, "*is already use-visible*");
with Glib;            use Glib;
with Glib.Bytes;      use Glib.Bytes;
with Graphene.Rect;   use Graphene.Rect;
with Gsk.Glshader;    use Gsk.Glshader;
with Gsk.Render_Node; use Gsk.Render_Node;

package Gsk.Glshader_Node is

   type Gsk_Glshader_Node_Record is new Gsk_Render_Node_Record with null record;
   type Gsk_Glshader_Node is access all Gsk_Glshader_Node_Record'Class;

   ------------------
   -- Constructors --
   ------------------

   function Get_Type return Glib.GType;
   pragma Import (C, Get_Type, "gsk_gl_shader_node_get_type");

   -------------
   -- Methods --
   -------------

   function Get_Shader
      (Self : Gsk_Glshader_Node) return Gsk.Glshader.Gsk_Glshader;
   --  Gets shader code for the node.
   --  @return the `GskGLShader` shader. Has transfer-ownership='none'.

   ----------------------
   -- GtkAda additions --
   ----------------------

   procedure Gtk_New
     (Self     : out Gsk_Glshader_Node;
      Shader   : not null access Gsk.Glshader.Gsk_Glshader_Record'Class;
      Bounds   : not null access Graphene.Rect.Graphene_Rect_T;
      Args     : Glib.Bytes.Gbytes;
      Children : Gsk.Render_Node.Gsk_Render_Node_Array);
   procedure Initialize
     (Self     : not null access Gsk_Glshader_Node_Record'Class;
      Shader   : not null access Gsk.Glshader.Gsk_Glshader_Record'Class;
      Bounds   : not null access Graphene.Rect.Graphene_Rect_T;
      Args     : Glib.Bytes.Gbytes;
      Children : Gsk.Render_Node.Gsk_Render_Node_Array);
   --  Creates a `GskRenderNode` that will render the given Shader into the
   --  area given by Bounds.
   --  The Args is a block of data to use for uniform input, as per types and
   --  offsets defined by the Shader. Normally this is generated by
   --  [methodGsk.GLShader.format_args] or [structGsk.ShaderArgsBuilder].
   --  See [classGsk.GLShader] for details about how the shader should be
   --  written.
   --  All the children will be rendered into textures (if they aren't already
   --  `GskTextureNodes`, which will be used directly). These textures will be
   --  sent as input to the shader.
   --  If the renderer doesn't support GL shaders, or if there is any problem
   --  when compiling the shader, then the node will draw pink. You should use
   --  [methodGsk.GLShader.compile] to ensure the Shader will work for the
   --  renderer before using it.
   --  Initialize does nothing if the object was already created with another
   --  call to Initialize* or G_New.
   --  @param Shader the `GskGLShader`
   --  @param Bounds the rectangle to render the shader into
   --  @param Args Arguments for the uniforms
   --  @param Children array of child nodes, these will be rendered to
   --  textures and used as input. Currently the GL backend supports
   --  up to 4 children

   function Gsk_Glshader_Node_New
     (Shader   : not null access Gsk.Glshader.Gsk_Glshader_Record'Class;
      Bounds   : not null access Graphene.Rect.Graphene_Rect_T;
      Args     : Glib.Bytes.Gbytes;
      Children : Gsk.Render_Node.Gsk_Render_Node_Array)
   return Gsk_Glshader_Node;
   --  Creates a `GskRenderNode` that will render the given Shader into the
   --  area given by Bounds.
   --  The Args is a block of data to use for uniform input, as per types and
   --  offsets defined by the Shader. Normally this is generated by
   --  [methodGsk.GLShader.format_args] or [structGsk.ShaderArgsBuilder].
   --  See [classGsk.GLShader] for details about how the shader should be
   --  written.
   --  All the children will be rendered into textures (if they aren't already
   --  `GskTextureNodes`, which will be used directly). These textures will be
   --  sent as input to the shader.
   --  If the renderer doesn't support GL shaders, or if there is any problem
   --  when compiling the shader, then the node will draw pink. You should use
   --  [methodGsk.GLShader.compile] to ensure the Shader will work for the
   --  renderer before using it.
   --  @param Shader the `GskGLShader`
   --  @param Bounds the rectangle to render the shader into
   --  @param Args Arguments for the uniforms
   --  @param Children array of child nodes, these will be rendered to
   --  textures and used as input. Currently the GL backend supports
   --  up to 4 children

   overriding function Create
      (Object : not null access System.Address)
       return Gsk_Glshader_Node_Record;

private
   for Gsk_Glshader_Node_Record'External_Tag use "GskGLShaderNode";
end Gsk.Glshader_Node;
