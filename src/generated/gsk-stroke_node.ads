--  A render node that will fill the area determined by stroking the the given
--  [structGsk.Path] using the [structGsk.Stroke] attributes.

pragma Warnings (Off, "*is already use-visible*");
with Glib;            use Glib;
with Gsk.Path;        use Gsk.Path;
with Gsk.Render_Node; use Gsk.Render_Node;
with Gsk.Stroke;      use Gsk.Stroke;

package Gsk.Stroke_Node is

   type Gsk_Stroke_Node_Record is new Gsk_Render_Node_Record with null record;
   type Gsk_Stroke_Node is access all Gsk_Stroke_Node_Record'Class;

   ------------------
   -- Constructors --
   ------------------

   procedure Gtk_New
      (Self   : out Gsk_Stroke_Node;
       Child  : Gsk.Render_Node.Gsk_Render_Node;
       Path   : Gsk.Path.Gsk_Path;
       Stroke : Gsk.Stroke.Gsk_Stroke);
   procedure Initialize
      (Self   : not null access Gsk_Stroke_Node_Record'Class;
       Child  : Gsk.Render_Node.Gsk_Render_Node;
       Path   : Gsk.Path.Gsk_Path;
       Stroke : Gsk.Stroke.Gsk_Stroke);
   --  Creates a Gsk.Render_Node.Gsk_Render_Node that will fill the outline
   --  generated by stroking the given Path using the attributes defined in
   --  Stroke.
   --  The area is filled with Child.
   --  GSK aims to follow the SVG semantics for stroking paths. E.g.
   --  zero-length contours will get round or square line caps drawn,
   --  regardless whether they are closed or not.
   --  Since: gtk+ 4.14
   --  Initialize does nothing if the object was already created with another
   --  call to Initialize* or G_New.
   --  @param Child The node to stroke the area with
   --  @param Path The path describing the area to stroke
   --  @param Stroke The stroke attributes to use

   function Gsk_Stroke_Node_New
      (Child  : Gsk.Render_Node.Gsk_Render_Node;
       Path   : Gsk.Path.Gsk_Path;
       Stroke : Gsk.Stroke.Gsk_Stroke) return Gsk_Stroke_Node;
   --  Creates a Gsk.Render_Node.Gsk_Render_Node that will fill the outline
   --  generated by stroking the given Path using the attributes defined in
   --  Stroke.
   --  The area is filled with Child.
   --  GSK aims to follow the SVG semantics for stroking paths. E.g.
   --  zero-length contours will get round or square line caps drawn,
   --  regardless whether they are closed or not.
   --  Since: gtk+ 4.14
   --  @param Child The node to stroke the area with
   --  @param Path The path describing the area to stroke
   --  @param Stroke The stroke attributes to use

   function Get_Type return Glib.GType;
   pragma Import (C, Get_Type, "gsk_stroke_node_get_type");

   -------------
   -- Methods --
   -------------

   function Get_Child
      (Self : Gsk_Stroke_Node) return Gsk.Render_Node.Gsk_Render_Node;
   --  Gets the child node that is getting drawn by the given Node.
   --  Since: gtk+ 4.14
   --  @return The child that is getting drawn. Has transfer-ownership='none'.

   function Get_Path (Self : Gsk_Stroke_Node) return Gsk.Path.Gsk_Path;
   --  Retrieves the path that will be stroked with the contents of the Node.
   --  Since: gtk+ 4.14
   --  @return a Gsk.Path.Gsk_Path. Has transfer-ownership='none'.

   function Get_Stroke (Self : Gsk_Stroke_Node) return Gsk.Stroke.Gsk_Stroke;
   --  Retrieves the stroke attributes used in this Node.
   --  Since: gtk+ 4.14
   --  @return a Gsk.Stroke.Gsk_Stroke. Has transfer-ownership='none'.

   ----------------------
   -- GtkAda additions --
   ----------------------

   overriding function Create
      (Object : not null access System.Address)
       return Gsk_Stroke_Node_Record;

private
   for Gsk_Stroke_Node_Record'External_Tag use "GskStrokeNode";
end Gsk.Stroke_Node;
